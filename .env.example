# 息壤 0.4.4：平台无关的兼容型生成接口示例。
# 复制为 .env 后仍需由启动脚本或系统环境显式加载；前端不会读取这些变量。

XIRANG_AI_BASE_URL=https://your-ai-platform.example/v1
XIRANG_AI_API_KEY=replace-with-your-private-key
XIRANG_AI_MODEL=replace-with-model-id

# 目标平台的生成路径、鉴权头和鉴权前缀。
XIRANG_AI_ENDPOINT=/chat/completions
XIRANG_AI_AUTH_HEADER=Authorization
XIRANG_AI_AUTH_SCHEME=Bearer

# 可选：json_schema、json_object 或 none。
XIRANG_AI_RESPONSE_FORMAT=json_schema
XIRANG_AI_TIMEOUT_SECONDS=60
